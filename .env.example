# Environment Configuration - Digital Twin Mining Supply Chain

# Application
APP_NAME="Resilience-Driven Digital Twin for Underground Mining"
APP_ENV=development
DEBUG=True
SECRET_KEY=supersecretkey_mining_digital_twin_jwt_token_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# In production, use PostgreSQL: postgresql://postgres:postgres@localhost:5432/mining_dt
# In local development without Postgres running, auto-fallbacks to SQLite:
DATABASE_URL=sqlite:///./mining_digital_twin.db

# Simulation & Science Settings
DEFAULT_RANDOM_SEED=42
MONTE_CARLO_RUNS=500
SIMULATION_HORIZON_DAYS=365
BOOTSTRAP_ITERATIONS=10000

# Backend API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Streamlit
STREAMLIT_PORT=8501
